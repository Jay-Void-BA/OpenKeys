+    fn copied_and_retained_closure_drops_exactly_once_after_last_release() {
+        struct Probe(Rc<Cell<u32>>);
+        impl Drop for Probe {
+            fn drop(&mut self) { self.0.set(self.0.get() + 1); }
+        }
+        let drops = Rc::new(Cell::new(0));
+        let probe = Probe(drops.clone());
+        let block = ConcreteBlock::new(move || {
+            let _borrow = &probe;
+            19u64
+        }).copy();
+        let retained = block.clone();
+        assert_eq!(unsafe { retained.call(()) }, 19);
+        drop(block);
+        assert_eq!(drops.get(), 0);
+        assert_eq!(unsafe { retained.call(()) }, 19);
+        drop(retained);
+        assert_eq!(drops.get(), 1);
+    }
